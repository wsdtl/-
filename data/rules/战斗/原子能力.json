{
  "版本": "晓楠修仙.原子能力.v1",
  "原子能力": {
    "固定属性加成": {
      "类别": "装配",
      "执行器": "装配属性",
      "说明": "功法装配后直接写入人物战斗面板的固定属性。",
      "字段": {
        "属性": {"类型": "属性数值表", "必填": true, "最少项": 1}
      }
    },
    "主动技能": {
      "类别": "装配",
      "执行器": "装配主动技能",
      "说明": "把一组战斗效果装配为可轮转施展的主动招式。",
      "字段": {
        "名称": {"类型": "字符串", "必填": true},
        "精神消耗": {"类型": "数字", "默认": 0, "最小": 0},
        "冷却回合": {"类型": "整数", "默认": 0, "最小": 0},
        "效果": {"类型": "能力数组", "必填": true, "最少项": 1, "允许类别": ["组合", "效果", "引用"]}
      }
    },
    "被动技能": {
      "类别": "装配",
      "执行器": "装配被动技能",
      "说明": "把监听战斗事件的效果装配为常驻被动。",
      "字段": {
        "名称": {"类型": "字符串", "必填": true},
        "效果": {"类型": "能力数组", "必填": true, "最少项": 1, "允许能力": ["监听事件", "引用被动机制"]}
      }
    },
    "引用战斗机制": {
      "类别": "引用",
      "执行器": "引用机制",
      "说明": "复用机制库中的主动、组合或普通效果。",
      "字段": {
        "机制": {"类型": "机制引用", "必填": true, "目标类别": ["组合", "效果"]}
      }
    },
    "引用被动机制": {
      "类别": "引用",
      "执行器": "引用机制",
      "说明": "复用机制库中的事件监听效果。",
      "字段": {
        "机制": {"类型": "机制引用", "必填": true, "目标类别": ["触发"]}
      }
    },
    "顺序执行": {
      "类别": "组合",
      "执行器": "顺序执行",
      "说明": "从前到后依次结算一组效果。",
      "字段": {
        "效果": {"类型": "能力数组", "必填": true, "最少项": 1, "允许类别": ["组合", "效果", "引用"]}
      }
    },
    "条件执行": {
      "类别": "组合",
      "执行器": "条件执行",
      "说明": "条件全部成立时结算成立效果，否则结算可选的不成立效果。",
      "字段": {
        "条件": {"类型": "能力数组", "必填": true, "最少项": 1, "允许类别": ["条件"]},
        "成立效果": {"类型": "能力数组", "必填": true, "最少项": 1, "允许类别": ["组合", "效果", "引用"]},
        "不成立效果": {"类型": "能力数组", "默认": [], "允许类别": ["组合", "效果", "引用"]}
      }
    },
    "监听事件": {
      "类别": "触发",
      "执行器": "监听事件",
      "说明": "满足事件、关系与条件时结算效果。",
      "字段": {
        "事件": {"类型": "事件引用", "必填": true},
        "事件关系": {"类型": "字符串", "默认": "自身相关", "选项": ["自身为来源", "自身为承受者", "自身相关", "任意"]},
        "条件": {"类型": "能力数组", "默认": [], "允许类别": ["条件"]},
        "接受派生事件": {"类型": "布尔", "默认": false},
        "每条事件链最多触发": {"类型": "整数", "默认": 1, "最小": 1, "最大": 1},
        "每次行动最多触发": {"类型": "整数", "最小": 1},
        "每场战斗最多触发": {"类型": "整数", "最小": 1},
        "优先级": {"类型": "整数", "默认": 0, "最小": 0, "最大": 0},
        "效果": {"类型": "能力数组", "必填": true, "最少项": 1, "允许类别": ["组合", "效果", "引用"]}
      },
      "约束": [
        {
          "当": {"字段": "事件", "等于": "受到致命伤害"},
          "数组执行器数量": {"字段": "效果", "执行器": "抵挡致命伤害", "最少": 1, "最多": 1}
        }
      ]
    },
    "状态周期触发": {
      "类别": "触发",
      "执行器": "监听事件",
      "说明": "状态承受者行动开始时结算一次周期伤害。",
      "字段": {
        "事件": {"类型": "事件引用", "必填": true, "选项": ["行动开始"]},
        "效果": {"类型": "能力数组", "必填": true, "最少项": 1, "最多项": 1, "允许执行器": ["造成伤害"]}
      }
    },
    "读取数值": {
      "类别": "数值",
      "执行器": "读取数值",
      "说明": "从固定值、参战者属性或当前事件中读取战斗数值。",
      "字段": {
        "来源": {"类型": "字符串", "必填": true, "选项": ["固定值", "自身属性", "效果来源属性", "目标属性", "自身当前血气", "自身当前精神", "自身已损失精神", "本次伤害"]},
        "属性": {"类型": "属性引用"},
        "固定值": {"类型": "数字"},
        "百分比": {"类型": "数字", "默认": 100, "最小": -1000, "最大": 1000},
        "最低值": {"类型": "数字"},
        "最高值": {"类型": "数字"},
        "读取时机": {"类型": "字符串", "默认": "执行时", "选项": ["执行时", "施加时快照"]}
      },
      "约束": [
        {"当": {"字段": "来源", "等于": "固定值"}, "必填": ["固定值"]},
        {"当": {"字段": "来源", "属于": ["自身属性", "效果来源属性", "目标属性"]}, "必填": ["属性"]}
      ]
    },
    "选择目标": {
      "类别": "目标",
      "执行器": "选择目标",
      "说明": "选择当前效果的承受者。",
      "字段": {
        "范围": {"类型": "字符串", "必填": true, "选项": ["自身", "当前目标", "效果来源"]}
      }
    },
    "选择自身": {
      "类别": "目标",
      "执行器": "选择目标",
      "说明": "只允许选择效果来源自身。",
      "字段": {
        "范围": {"类型": "字符串", "必填": true, "选项": ["自身"]}
      }
    },
    "选择技能": {
      "类别": "目标",
      "执行器": "选择技能",
      "说明": "从战斗中的技能集合选择技能。",
      "字段": {
        "范围": {"类型": "字符串", "必填": true, "选项": ["冷却中的技能"]},
        "排序": {"类型": "字符串", "默认": "无", "选项": ["无", "随机", "冷却从低到高", "冷却从高到低"]},
        "数量": {"类型": "整数", "默认": 1, "最小": 1, "最大": 100},
        "选择全部": {"类型": "布尔", "默认": false}
      }
    },
    "概率条件": {
      "类别": "条件",
      "执行器": "概率条件",
      "说明": "按百分比概率判断条件是否成立。",
      "字段": {
        "概率": {"类型": "数字", "必填": true, "最小": 0, "最大": 100}
      }
    },
    "标签条件": {
      "类别": "条件",
      "执行器": "标签条件",
      "说明": "判断本次伤害是否包含指定标签。",
      "字段": {
        "对象": {"类型": "字符串", "必填": true, "选项": ["伤害"]},
        "关系": {"类型": "字符串", "必填": true, "选项": ["包含任一", "包含全部", "全部不含"]},
        "标签": {"类型": "字符串数组", "必填": true, "最少项": 1}
      }
    },
    "造成伤害": {
      "类别": "效果",
      "执行器": "造成伤害",
      "说明": "通过统一伤害流水线对目标造成伤害。",
      "字段": {
        "名称": {"类型": "字符串"},
        "目标": {"类型": "能力", "必填": true, "允许执行器": ["选择目标"]},
        "数值": {"类型": "数值或能力", "必填": true, "允许执行器": ["读取数值"]},
        "伤害形式": {"类型": "字符串", "默认": "直接", "选项": ["直接", "持续", "反伤", "分摊", "转移"]},
        "防御规则": {"类型": "字符串", "默认": "普通", "选项": ["普通", "无视防御", "真实"]},
        "能否暴击": {"类型": "布尔", "默认": false},
        "能否格挡": {"类型": "布尔", "默认": true},
        "能否触发吸血": {"类型": "布尔", "默认": false},
        "标签": {"类型": "字符串数组", "默认": []}
      }
    },
    "恢复资源": {
      "类别": "效果",
      "执行器": "恢复资源",
      "说明": "恢复目标已登记的战斗资源。",
      "字段": {
        "目标": {"类型": "能力", "必填": true, "允许执行器": ["选择目标"]},
        "资源": {"类型": "资源引用", "必填": true},
        "数值": {"类型": "数值或能力", "必填": true, "允许执行器": ["读取数值"]}
      }
    },
    "添加状态": {
      "类别": "效果",
      "执行器": "添加状态",
      "说明": "为目标添加带持续时间、属性修正或周期触发的状态。",
      "字段": {
        "目标": {"类型": "能力", "必填": true, "允许执行器": ["选择目标"]},
        "状态": {
          "类型": "对象",
          "必填": true,
          "字段": {
            "名称": {"类型": "字符串", "必填": true},
            "分类": {"类型": "字符串", "默认": "中性", "选项": ["正面", "负面", "中性", "控制"]},
            "持续单位": {"类型": "字符串", "默认": "状态承受者行动", "选项": ["状态承受者行动"]},
            "持续数值": {"类型": "整数", "默认": 1, "最小": 1},
            "扣除时机": {"类型": "字符串", "默认": "对应事件结束后", "选项": ["对应事件结束后"]},
            "叠加范围": {"类型": "字符串", "默认": "同名共享", "选项": ["同名共享", "按效果来源分组"]},
            "重复方式": {"类型": "字符串", "默认": "刷新持续", "选项": ["刷新持续"]},
            "层数": {"类型": "整数", "默认": 1, "最小": 1, "最大": 1},
            "层数上限": {"类型": "整数", "默认": 1, "最小": 1, "最大": 1},
            "标签": {"类型": "字符串数组", "默认": []},
            "属性": {"类型": "属性数值表", "默认": {}},
            "触发": {"类型": "能力数组", "默认": [], "最多项": 1, "允许能力": ["状态周期触发"]},
            "是否进行控制判定": {"类型": "布尔", "默认": false},
            "基础控制命中率": {"类型": "数字", "默认": 100, "最小": 0, "最大": 100},
            "是否受韧性影响": {"类型": "布尔", "默认": true}
          }
        }
      }
    },
    "修改技能冷却": {
      "类别": "效果",
      "执行器": "修改技能冷却",
      "说明": "按选择规则修改一个或多个技能的剩余冷却。",
      "字段": {
        "目标": {"类型": "能力", "必填": true, "允许能力": ["选择自身"]},
        "技能": {"类型": "能力", "必填": true, "允许执行器": ["选择技能"]},
        "方式": {"类型": "字符串", "必填": true, "选项": ["增加", "减少", "清空", "设置"]},
        "数值": {"类型": "整数", "默认": 0, "最小": 0}
      }
    },
    "抵挡致命伤害": {
      "类别": "效果",
      "执行器": "抵挡致命伤害",
      "说明": "把一次致命伤害结算后的最低血气抬到指定值。",
      "字段": {
        "目标": {"类型": "能力", "必填": true, "允许能力": ["选择自身"]},
        "保留血气": {"类型": "数字", "默认": 1, "最小": 1}
      }
    }
  }
}
